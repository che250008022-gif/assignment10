#include <iostream>
#include <string>
using namespace std;

struct SalesRecord {
    string month;
    float amount;
};
int main() {
    const int SIZE = 12;
    SalesRecord sales[SIZE];
    float total = 0;
    cout << "Enter sales data for 12 months:\n";
    for (int i = 0; i < SIZE; ++i) {
        cout << "Enter month name: ";
        cin >> sales[i].month;
        cout << "Enter sales amount: ";
        cin >> sales[i].amount;
        total += sales[i].amount;
    }
    float average = total / SIZE;
    cout << "\nYearly average sales: " << average << endl;
    cout << "\nMonths with sales above the yearly average:\n";
    for (int i = 0; i < SIZE; ++i) {
        if (sales[i].amount > average) {
            cout << sales[i].month << " (" << sales[i].amount << ")\n";
        }
    }
    return 0;
}
