#include <iostream>
#include <string>
using namespace std;

// Define structure
struct Employee {
    int id;
    string name;
    float salary;
};

int main() {
    Employee emp[10]; // Array of 10 employees

    // Input employee details
    cout << "Enter details of 10 employees:\n";
    for (int i = 0; i < 10; i++) {
        cout << "\nEmployee " << i + 1 << ":\n";
        cout << "Enter ID: ";
        cin >> emp[i].id;
        cout << "Enter Name: ";
        cin >> emp[i].name;
        cout << "Enter Salary: ";
        cin >> emp[i].salary;
    }

    int choice;
    do {
        cout << "\n===== MENU =====\n";
        cout << "1. Display all employee details\n";
        cout << "2. Search employee by ID\n";
        cout << "3. Increase salary of employees earning < ₹30000 by 10%\n";
        cout << "4. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1: {
                cout << "\n--- Employee Details ---\n";
                for (int i = 0; i < 10; i++) {
                    cout << "ID: " << emp[i].id
                         << ", Name: " << emp[i].name
                         << ", Salary: ₹" << emp[i].salary << endl;
                }
                break;
            }

            case 2: {
                int searchId;
                cout << "Enter Employee ID to search: ";
                cin >> searchId;
                bool found = false;

                for (int i = 0; i < 10; i++) {
                    if (emp[i].id == searchId) {
                        cout << "Employee Found:\n";
                        cout << "ID: " << emp[i].id
                             << ", Name: " << emp[i].name
                             << ", Salary: ₹" << emp[i].salary << endl;
                        found = true;
                        break;
                    }
                }
                if (!found)
                    cout << "Employee with ID " << searchId << " not found.\n";
                break;
            }

            case 3: {
                cout << "Increasing salary of employees earning < ₹30000 by 10%...\n";
                for (int i = 0; i < 10; i++) {
                    if (emp[i].salary < 30000) {
                        emp[i].salary *= 1.10; // Increase by 10%
                    }
                }
                cout << "Salary update complete.\n";
                break;
            }

            case 4:
                cout << "Exiting program...\n";
                break;

            default:
                cout << "Invalid choice. Try again.\n";
        }

    } while (choice != 4);

    return 0;
}
